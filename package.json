{
  "name": "telltale",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "collect": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env apps/collector/src/index.ts",
    "collect:status": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env apps/collector/src/status.ts",
    "fixtures:record": "node apps/collector/scripts/record-fixtures.ts",
    "test": "node --disable-warning=ExperimentalWarning --test \"packages/*/test/**/*.test.ts\" \"apps/*/test/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "typescript": "^7.0.2"
  }
}
